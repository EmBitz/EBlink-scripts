/////////////////////////////////////////////////////////////////////////////////
//
//          STM32F0 / F1 and F3  -  ALTERNATIVE with RAM loader fallback
//
//  *****************************************************************************
//  *                                                                           *
//  *  WARNING: THIS SCRIPT IS AN EXAMPLE / WORKAROUND, NOT THE DEFAULT SCRIPT  *
//  *                                                                           *
//  *  It works, but the right solution is to UPDATE THE PROBE FIRMWARE.        *
//  *  Only old ST-Link/V2 firmware doesn't support 16bit memory access.        *
//  *  Current ST-Link, J-Link and CMSIS-DAP firmware all support it, and then  *
//  *  the normal f0_f1_f3.script is used and this fallback never runs.        *
//  *                                                                           *
//  *  The fallback uploads a small flash loader + one sector to target RAM:    *
//  *   - loader at 0x20000000, sector data from 0x20000030                     *
//  *   - needs (page size + 48) bytes of RAM, e.g. 2KB pages -> 2.1KB RAM      *
//  *   - the RAM content is overwritten                                        *
//  *                                                                           *
//  *****************************************************************************
//
//  Same as f0_f1_f3.script, but if the probe doesn't support direct 16bit
//  memory access (INTERFACE_NOT_SUPPORTED) the sector is programmed by the
//  external RAM flash loader below.
//

// TODO: - Dual bank F103_XL

const FLASH_BASE  0x40022000

const FLASH_KEY   0x04
const FLASH_SR    0x0C
const FLASH_CR    0x10
const FLASH_AR    0x14

// Register flags
const FLASH_SR_BSY      0x01
const FLASH_SR_PROGERR  0x04
const FLASH_SR_WRPERR   0x10
const FLASH_SR_EOP      0x20

const FLASH_CR_LOCK     0x80
const FLASH_CR_STRT     0x40

const FLASH_CR_MER      4
const FLASH_CR_PER      2
const FLASH_CR_PG       1

const FLASH_KEY1        0x45670123
const FLASH_KEY2        0xCDEF89AB

// Error flags (PROGERR = PGERR: programming a not erased half word)
FLASH_SR_ERROR <- (FLASH_SR_PROGERR | FLASH_SR_WRPERR)

// Status flags which are cleared by writing 1
FLASH_SR_CLEAR <- (FLASH_SR_ERROR | FLASH_SR_EOP)

/////////////////////////////////////////////////////////
// Half word external flash loader (Thumb), parameters :
//  r0 = scratch area (source data in RAM)
//  r1 = start program address (flash)
//  r2 = Length in half words
//
//  Skips erased half words (0xFFFF), waits for BSY after every half word,
//  stops on PGERR. Ends with BKPT, r2 == 0 if all half words are written.
//
const extFlashLoader = "\
\x01\x25\x04\x26\x08\x4C\x09\x4F\x03\x88\xBB\x42\x05\xD0\x0B\x80\
\xE3\x68\x2B\x42\xFC\xD1\x33\x42\x04\xD1\x02\x30\x02\x31\x01\x3A\
\x00\x2A\xF1\xD1\x00\xBE\xC0\x46\x00\x20\x02\x40\xFF\xFF\x00\x00"

const EXT_LOADER_SIZE  48 //bytes

const LOADER_ADDR      0x20000000
const SCRATCH_ADDR     0x20000030  // The area for program upload

maxFlashSpeed   <- 10000  // 10MHz is max speed for direct programming (we think)

/////////////////////////////////////////////////////////////////////////////////
//
//   Called by EBlink to initialize upcoming flash operations.
//
function ebFlashStart()
{
    try{
        // Override the maximum flash speed from cli
        if (isScriptObject("FLASH_SPEED") && FLASH_SPEED>0){
            maxFlashSpeed = FLASH_SPEED
            printf("Flash speed set: %d KHz\n", maxFlashSpeed)
        }

        // Check that we don't go faster than the user selected on the cli
        if(maxFlashSpeed > intrfApi.getSpeed())
            maxFlashSpeed = intrfApi.getSpeed()

        // Be sure that the core is halted and all clocks are reset
        targetApi.reset(SYSTEM_RESET)

        // Wait for halt
        local time = GetTickCount();
        do{
            targetApi.poll()

          // Timeout of 1sec
            if(GetTickCount() - time > 1000)
              throw ERROR_TIMEOUT

        } while(targetApi.getState() != TARGET_HALTED )

        // Unlock flash
        flashUnlock()

        // Load the flash loader in advance in target RAM in case we need it
        intrfApi.loadString(LOADER_ADDR, extFlashLoader, EXT_LOADER_SIZE)

        return ERROR_OK
    }

    // Catch all the sector write errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: couldn't initialize target! [%s]\n", errorToStr(e) )
       return ERROR_NOTIFIED
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Called by EBlink to erase a sector
//   Erase sequence according ST user manual
//    - ebFlashStart() is already called
//    - ebFlashDone() will be called if all flash operations are ready
//
function ebFlashErase(sector, address)
{
    try{
        // Clear EOP and the error flags of a previous operation,
        // otherwise the EOP check below sees the EOP of the last write
        flashClearStatus()

        // (1) Set the PER bit in the FLASH_CR register to enable page erasing
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_PER )

        // (2) Program the FLASH_AR register to select a page to erase
        intrfApi.write(FLASH_BASE + FLASH_AR, address )

        // (3) Set the STRT bit (keep PER set) in the FLASH_CR register to start the erasing
        intrfApi.write(FLASH_BASE + FLASH_CR,  FLASH_CR_STRT| FLASH_CR_PER)

        // (4) Wait until the BSY bit is reset in the FLASH_SR register
        local status = flashWaitBusy(1500, false)

        // (7) Reset the PER Bit to disable the page erase
        intrfApi.write(FLASH_BASE + FLASH_CR, 0 )

        //  (5) Check for errors and the EOP flag in the FLASH_SR register
        if( (status & FLASH_SR_ERROR) || !(status & FLASH_SR_EOP) ){
            errorf("ERROR: erasing sector %d failed! Flags: %s\n", sector, flashErrorStr(status))
            throw ERROR_NOTIFIED
        }

        // (6) Clear EOP flag by software by writing EOP at 1
        flashClearStatus()

        return ERROR_OK
    }

    // Catch all the sector erase errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: erasing sector %d failed! [%s]\n", sector, errorToStr(e) )
       return ERROR_NOTIFIED
    }
}


/////////////////////////////////////////////////////////////////////////////////
//
//  Called by EBlink to write a sector.
//
function ebFlashWrite(sector, address, buffer)
{
    try{
        // The flash is programmed per half word, the buffer must be a
        // multiple of 2 bytes (EBlink trims it to the last non-erased byte)
        buffer.trim(2)

        // Clear EOP and the error flags of a previous operation
        flashClearStatus()

        // Enable the program flag PG in flash_CR
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_PG )

        // For direct flash writing we can't be too fast.
        local probeSpeed = intrfApi.getSpeed()
        intrfApi.setSpeed(maxFlashSpeed)

        // Write buffer to flash with 16bit memory access, always restore the probe speed
        local result = ERROR_OK
        try{
            intrfApi.writeBuf(buffer, address, 16)
        }
        catch(e){
            if(isString(e)){
                intrfApi.setSpeed(probeSpeed)
                throw e
            }
            result = e
        }

        // Restore probe speed
        intrfApi.setSpeed(probeSpeed)

        // Probe doesn't support 16bit memory access: fall back to the RAM flash loader
        // (old ST-Link/V2 firmware, better update the probe!)
        if(result == INTERFACE_NOT_SUPPORTED){
            debugf("No 16bit memory access, using the RAM flash loader\n")
            flashLoaderWrite(address, buffer)
        }
        else if(result != ERROR_OK)
            throw result

        // Wait until the last half word is programmed
        local status = flashWaitBusy(1000, false)

        // Disable the program flag PG in flash_CR
        intrfApi.write(FLASH_BASE + FLASH_CR, 0 )

        // Check for errors (PGERR: not erased, WRPRTERR: write protected)
        if( status & FLASH_SR_ERROR ){
            errorf("ERROR: writing sector %d failed! Flags: %s\n", sector, flashErrorStr(status))
            throw ERROR_NOTIFIED
        }

        // Clear EOP
        flashClearStatus()

        return ERROR_OK
    }

    // Catch all the sector write errors
    catch(e){
       // Leave the flash in a clean state: PG off
       try{ intrfApi.write(FLASH_BASE + FLASH_CR, 0 ) } catch(e2){}

       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: writing sector %d failed! [%s]\n", sector, errorToStr(e) )
       return ERROR_NOTIFIED
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
// Called by EBlink if all flash operations are ready
//
function ebFlashDone()
{
    try{
        // Relock the flash by setting the FLASH_CR_LOCK in the flash CR register
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_LOCK )
        return ERROR_OK
    }

    // Catch all the lock errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("Error: locking flash failed! [%s]\n", errorToStr(e) )
       return ERROR_NOTIFIED
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Program a sector with the RAM flash loader (PG must already be set)
//
function flashLoaderWrite(address, buffer)
{
    // Write buffer to data ram space
    intrfApi.writeBuf(buffer, SCRATCH_ADDR)

    // Initialize flash loader
    targetApi.writeReg("R0", SCRATCH_ADDR)         // Data address to be written
    targetApi.writeReg("R1", address)              // Target address in flash
    targetApi.writeReg("R2", buffer.getSize()/2)   // Half words count to be written

    // Run the flash loader, don't block so we can use a timeout
    targetApi.execute(LOADER_ADDR, false)

    // Wait until the loader hits its BKPT (timeout 5 sec)
    local time = GetTickCount()
    do{
        if(GetTickCount() - time > 5000){
            targetApi.halt()
            errorf("ERROR: RAM flash loader timeout\n")
            throw ERROR_NOTIFIED
        }
        targetApi.poll()
    } while(targetApi.getState() != TARGET_HALTED )

    // Check flash loader result, if R2 is 0 then all data is written.
    // If not, the loader stopped on an error which is checked by the caller in FLASH_SR.
    local left = targetApi.readReg("R2")
    if(left != 0)
        debugf("RAM flash loader stopped, %d half words not written\n", left)
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Clear EOP and the error flags (cleared by writing 1)
//
function flashClearStatus()
{
    intrfApi.write(FLASH_BASE + FLASH_SR, FLASH_SR_CLEAR)
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Wait until BSY is cleared, return FLASH_SR
//   (animate: show the cursor animation, for long operations)
//
function flashWaitBusy(timeout, animate)
{
    local status
    local time = GetTickCount()
    do{
        if(animate)
            AnimateCursor()

        if(GetTickCount() - time > timeout)
            throw ERROR_TIMEOUT

        status = intrfApi.read(FLASH_BASE + FLASH_SR)
    }while ( status & FLASH_SR_BSY)

    if(animate)
        AnimateDone()

    return status
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Return the names of the error flags in a FLASH_SR value
//
function flashErrorStr(status)
{
    local s = ""
    if(status & FLASH_SR_PROGERR) s += "PGERR (not erased) "
    if(status & FLASH_SR_WRPERR)  s += "WRPRTERR (write protected) "
    if(!(status & FLASH_SR_EOP))  s += "no EOP "
    return (s == "") ? "none" : s
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Unlock the flash
//
function flashUnlock()
{
    if( intrfApi.read(FLASH_BASE + FLASH_CR) & FLASH_CR_LOCK )
    {
        // Unlock Flash
        intrfApi.write(FLASH_BASE + FLASH_KEY, FLASH_KEY1 )
        intrfApi.write(FLASH_BASE + FLASH_KEY, FLASH_KEY2 )

        if( intrfApi.read(FLASH_BASE + FLASH_CR) & FLASH_CR_LOCK )
           throw ERROR_UNLOCK
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
//  Called by EBlink if chip erase is needed (e.g. command line flashing)
//
//   Erase the whole chip
//   - If this function is not defined, sector by sector erase is used by EBlink.
//   - This is an isolated function, ebFlashStart and ebFlashDone are not called by EBlink
//
function ebFlashEraseChip()
{
    try{
        printf("Flash chip erase ");

        // Be sure that the target is halted
        targetApi.halt()

        // Unlock flash
        flashUnlock()

        // Clear EOP and the error flags of a previous operation
        flashClearStatus()

        // (1) Set the MER bit in the FLASH_CR register to enable mass erasing
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_MER )

        // (2) Set the STRT bit in the FLASH_CR register to start the erasing
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_MER | FLASH_CR_STRT )

        // (3) Wait until the BSY bit is reset in the FLASH_SR register (timeout 30 seconds)
        local status = flashWaitBusy(30000, true)

        // (6) Reset the MER Bit to disable the mass erase
        intrfApi.write(FLASH_BASE + FLASH_CR, 0 )

        // (4) Check for errors and the EOP flag in the FLASH_SR register
        if( (status & FLASH_SR_ERROR) || !(status & FLASH_SR_EOP) ){
            errorf("ERROR: mass erase failed! Flags: %s\n", flashErrorStr(status))
            throw ERROR_NOTIFIED
        }

        // (5) Clear EOP flag by software by writing EOP at 1
        flashClearStatus()

        // (7) Relock the flash by setting the FLASH_CR_LOCK in the flash CR register
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_LOCK )

        printf("done\n")
        return ERROR_OK
    }

    // Catch all the mass erase errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: mass erase failed! [%s]\n", errorToStr(e) )
       return ERROR_NOTIFIED
    }
}
