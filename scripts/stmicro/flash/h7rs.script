/////////////////////////////////////////////////////////////////////////////////
//
//                   STM32H7Rx/H7Sx flash (H7R3, H7R7, H7S3, H7S7)
//
//  ToDo:  - option programming
//
// The flash controller is not the H7 one (ST CMSIS stm32h7s7xx.h, HAL
// stm32h7rsxx_hal_flash.c):
//  - CR 0x10, SR 0x14, ISR 0x24 (flags), ICR 0x28 (clear)
//  - 64KB single bank, 8 sectors of 8KB, SSN bits 6..8
//  - 128-bit flash word, the HAL writes it with 16-bit accesses
//  - wait for QW (operation queue), errors in ISR
//

const FLASH_BASE 0x52002000

// Register offsets of the flash controller
const FLASH_ACR         (0x00)
const FLASH_KEYR        (0x04)
const FLASH_CR          (0x10)
const FLASH_SR          (0x14)
const FLASH_ISR         (0x24)
const FLASH_ICR         (0x28)

// FLASH_CR control bit flags
const FLASH_CR_LOCK         (1 << 0)
const FLASH_CR_PG           (1 << 1)
const FLASH_CR_SER          (1 << 2)
const FLASH_CR_BER          (1 << 3)
const FLASH_CR_FW           (1 << 4)
const FLASH_CR_START        (1 << 5)
const FLASH_CR_SSN_SHIFT    (6)
const FLASH_CR_SSN_MASK     (0x7 << 6)

// FLASH_SR flags
const FLASH_SR_BUSY         (1 << 0)   // Operation in progress
const FLASH_SR_WBNE         (1 << 1)   // Write buffer not empty
const FLASH_SR_QW           (1 << 2)   // Operation queue in progress

// FLASH_ISR flags (FLASH_ICR has the clear bits at the same positions)
const FLASH_ISR_EOPF        (1 << 16)
const FLASH_ISR_WRPERRF     (1 << 17)
const FLASH_ISR_PGSERRF     (1 << 18)
const FLASH_ISR_STRBERRF    (1 << 19)
const FLASH_ISR_OBLERRF     (1 << 20)
const FLASH_ISR_INCERRF     (1 << 21)
const FLASH_ISR_RDSERRF     (1 << 24)
const FLASH_ISR_SNECCERRF   (1 << 25)
const FLASH_ISR_DBECCERRF   (1 << 26)
const FLASH_ISR_CRCENDF     (1 << 27)
const FLASH_ISR_CRCRDERRF   (1 << 28)

// The errors the ST HAL checks after an operation (FLASH_FLAG_ISR_ERRORS)
const FLASH_ISR_ERROR_MASK  0x113E0000

// Also cleared before an operation, a stale ECC flag of a read is no flash error
const FLASH_ISR_CLEAR_MASK  0x1F3F0000

const FLASH_KEYR1  0x45670123
const FLASH_KEYR2  0xCDEF89AB

maxFlashSpeed   <- 24000 // Can be changed from CLI

/////////////////////////////////////////////////////////////////////////////////
//
// EBlink callback
//
//   Unlock the flash
//
function ebFlashStart()
{
    try{
        // Override the maximum flash speed from cli
        if (isScriptObject("FLASH_SPEED") && FLASH_SPEED>0){
            maxFlashSpeed = FLASH_SPEED
            printf("Flash speed set: %d KHz\n", maxFlashSpeed)
        }

        // Check that we don't go faster than the user selected on the cli
        if(maxFlashSpeed > intrfApi.getSpeed())
            maxFlashSpeed = intrfApi.getSpeed()

        // Be sure that the core is halted
        targetApi.reset(SYSTEM_RESET)

        // Wait for halt
        local time = GetTickCount()
        do{
            // Timeout of 1sec
            if(GetTickCount() - time > 1000)
                throw ERROR_TIMEOUT

            targetApi.poll()
        } while(targetApi.getState() != TARGET_HALTED )

        flashUnlock()
        return ERROR_OK
    }

    // Catch all the lock errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("Error: target initializing! [%s]\n", errorToStr(e) )
       return ERROR_NOTIFIED
    }
}


/////////////////////////////////////////////////////////////////////////////////
//
// EBlink callback
//
//   Sector erase sequence according the ST HAL
//
function ebFlashErase(sector, address)
{
    try{
        // Clear flags of a previous operation
        flashClearErrors()

        intrfApi.write(FLASH_BASE + FLASH_CR,
                       (sector << FLASH_CR_SSN_SHIFT ) | FLASH_CR_SER | FLASH_CR_START )

        flashCheckBusy(10000)

        // Clear the erase bits (same as the ST HAL)
        flashClearCr(FLASH_CR_SER | FLASH_CR_SSN_MASK)

        return ERROR_OK
    }

    // Catch all the sector erase errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: erasing address 0x%08X [sec %d] failed! [%s]\n", address, sector, errorToStr(e) )
       return ERROR_NOTIFIED
    }
}


/////////////////////////////////////////////////////////////////////////////////
//
// Flash write according the ST HAL
//
function ebFlashWrite(sector, address, buffer)
{
    try{
        // Flash must be programmed with flash words of 16 bytes
        buffer.trim(16)

        // Clear flags of a previous operation
        flashClearErrors()

        // Set the PG bit of the FLASH control register (FLASH_CR)
        intrfApi.write(FLASH_BASE + FLASH_CR,  FLASH_CR_PG )

        // Adjust the probe speed to the maximum for direct write
        local probeSpeed = intrfApi.getSpeed()
        intrfApi.setSpeed(maxFlashSpeed)

        // Program the flash with 16 bit accesses (same as the ST HAL)
        intrfApi.writeBuf(buffer, address, 16)

        // Restore probe speed
        intrfApi.setSpeed(probeSpeed)

        flashCheckBusy(2000)

        // Clear the PG bit
        flashClearCr(FLASH_CR_PG)

        return ERROR_OK
    }

    // Catch all the sector write errors
    catch(e){
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: writing sector %d failed! [%s]\n", sector, errorToStr(e) )
       return ERROR_NOTIFIED
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
// EBlink callback
//
function ebFlashDone()
{
    try{
        intrfApi.write( FLASH_BASE + FLASH_CR,
            intrfApi.read(FLASH_BASE + FLASH_CR) | FLASH_CR_LOCK )
        return ERROR_OK
    }
    catch(e) {
       if(catchString(e))
            return ERROR_NOTIFIED
       if(e < ERROR_NOTIFIED)
           errorf("ERROR: locking device\n")
        return ERROR_NOTIFIED
    }
}

/////////////////////////////////////////////////////////////////////////////////
//
//  Called by EBlink if chip erase is needed (e.g. command line flashing)
//
//   Erase the whole chip
//   - If this function is not defined, sector by sector erase is used by EBlink.
//   - This is an isolated function, ebFlashStart and ebFlashDone are not called by EBlink
//
function ebFlashEraseChip()
{
    try{
        printf("Flash chip erase ")

        targetApi.halt()
        flashUnlock()
        flashClearErrors()
        intrfApi.write(FLASH_BASE + FLASH_CR, FLASH_CR_BER | FLASH_CR_START )

        flashCheckBusy(30000)
        flashClearCr(FLASH_CR_BER)
        ebFlashDone()
        printf("done\n")
        return ERROR_OK
    }

    // Catch all the sector write errors
    catch(e){
        if(catchString(e))
           return ERROR_NOTIFIED
        if(e < ERROR_NOTIFIED)
           errorf("ERROR: mass erase failed! [%s]\n", errorToStr(e) )
        return ERROR_NOTIFIED
    }
}


/////////////////////////////////////////////////////////////////////////////////
//
//   Wait until the operation is ready (QW cleared, same as the ST HAL)
//   and check for errors
//
function flashCheckBusy(timeout)
{
    local time = GetTickCount()
    do{
        AnimateCursor()

        if(GetTickCount() - time > timeout)
            throw ERROR_TIMEOUT

    }while(intrfApi.read(FLASH_BASE + FLASH_SR) & FLASH_SR_QW)

    AnimateDone()

    // Clear errors and EOP, also when there is an error
    // (otherwise one error blocks every next erase/write)
    local value = intrfApi.read(FLASH_BASE + FLASH_ISR)
    intrfApi.write( FLASH_BASE + FLASH_ICR, value & FLASH_ISR_CLEAR_MASK)

    if( value & FLASH_ISR_ERROR_MASK)
        throw ERROR_FLASH
}

/////////////////////////////////////////////////////////////////////////////////
//
//   Clear the flags of a previous operation
//
function flashClearErrors()
{
    local value = intrfApi.read(FLASH_BASE + FLASH_ISR)
    if( value & FLASH_ISR_CLEAR_MASK )
        intrfApi.write( FLASH_BASE + FLASH_ICR, value & FLASH_ISR_CLEAR_MASK)
}


/////////////////////////////////////////////////////////////////////////////////
//
//   Clear control bits of the operation
//
function flashClearCr(bits)
{
    intrfApi.write(FLASH_BASE + FLASH_CR, intrfApi.read(FLASH_BASE + FLASH_CR) & ~bits)
}


/////////////////////////////////////////////////////////////////////////////////
//
//   Unlock the flash
//
function flashUnlock()
{
    // Already unlocked (e.g. by the application before ebFlashEraseChip)?
    // Writing the keys again is a wrong sequence and can lock CR until reset.
    if( !(intrfApi.read(FLASH_BASE + FLASH_CR) & FLASH_CR_LOCK) )
        return

    // Unlock Flash
    intrfApi.write(FLASH_BASE + FLASH_KEYR, FLASH_KEYR1 )
    intrfApi.write(FLASH_BASE + FLASH_KEYR, FLASH_KEYR2 )

    if(intrfApi.read(FLASH_BASE + FLASH_CR) & FLASH_CR_LOCK )
       throw ERROR_UNLOCK
}
