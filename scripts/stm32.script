//! STmicro
/////////////////////////////////////////////////////
//
//            STmicro cortex-M devices
//
//     The script tries to detect the right memory sizes
//     however, if this is not correct you can set the sizes
//     in kilobytes on the command line as:
//
//         -D FLASH_SIZE=xxx  and -D RAM_SIZE=xxxx
//
//     Fix chip_id for F4 rev A errata , Read CPU ID, as CoreID is the same for F2/F4 - 0x411
//     so we have 0x411 also as a cortex-M4 in the list (see patch).
//
//     If the probe can read the MEM-AP BASE (readDap), the device must be a
//     STmicro device according the JEP106 designer code of the ROM table.
//     Families without DBGMCU IDCODE are then found by the ROM table part
//     number (STMICRO_ROM). Otherwise (e.g. old STlink firmware) a warning
//     is given and only the DBGMCU IDCODE is used (STMICRO).
//

STMICRO <- {
	"M0+": { regs = [0x40015800], fam = {
		l0 = [0x417, 0x425, 0x447, 0x457],
		gx = [0x466, 0x456, 0x460, 0x467],
		c0 = [0x443, 0x453, 0x44C, 0x493, 0x44D],
		u0 = [0x459, 0x489] } },

	"M0":  { regs = [0x40015800], fam = {
		f0 = [0x440, 0x442, 0x444, 0x445, 0x448] } },

	"M3":  { regs = [0xE0042000], fam = {
		f1 = [0x410, 0x412, 0x414, 0x418, 0x420, 0x428, 0x430],
		f2 = [0x411],
		l1 = [0x416, 0x427, 0x429, 0x436, 0x437] } },

	"M4":  { regs = [0xE0042000], fam = {
		f4 = [0x413, 0x419, 0x421, 0x423, 0x431, 0x433, 0x434, 0x441, 0x458, 0x463, 0x411 /* <- patch */],
		f3 = [0x422, 0x432, 0x438, 0x439, 0x446],
		l4 = [0x415, 0x435, 0x461, 0x462, 0x464, 0x470, 0x471],
		gx = [0x468, 0x469, 0x479],
		wx = [0x494, 0x495, 0x496, 0x497] } },

	"M7":  { regs = [0x5C001000, 0xE0042000], fam = {
		f7 = [0x449, 0x451, 0x452],
		h7 = [0x450, 0x480, 0x483],
		h7rs = [0x485] } },

	"M33": { regs = [0xE0044000, 0x44024000, 0x44026000 /* G5 */], fam = {
		u3u5 = [0x455, 0x476, 0x481, 0x482, 0x42A, 0x42B, 0x42C, 0x454],
		wba = [0x492, 0x4B0, 0x4B2],
		l5 = [0x472],
		h5 = [0x474, 0x478, 0x47C, 0x484, 0x47A],
		g5 = [0x44A, 0x44B],
		c5 = [0x44E, 0x44F, 0x45A] } }
}

// Families identified by the ROM table part number (no DBGMCU IDCODE)
STMICRO_ROM <- {
	wb0 = [0x01E]
}

// JEP106 designer codes of the ROM table
const JEP106_ST             0x020
const JEP106_ERRATA_STM32WX 0x420  // Not JEP106 compliant ST code

intrfApi <- InterfAPI()  // Global so that all included script files also have access
targetApi<- TargetAPI()  // Global interface to the target class
deviceId <- 0            // Global deviceId
resetVector <- 0x08000000 // Vector table after reset, the device script can change it

// To decalare user errors below -1000
//const ERROR_MY_ERROR1 -1001
//const ERROR_MY_ERROR2 -1002

/////////////////////////////////////////////////////
//
//  EBlink called Entry point
//
function ebMain()
{
	try{
		findDevice()
	}
	catch(e){
		// Catch any string exceptions (e.g. Squirrel error's)
		if(catchString(e))
			return ERROR_NOTIFIED

		if( e == ERROR_NOT_FOUND)
			if(deviceId){
				printf("\n\nPlease report this ID so that we can add it.\n")
				errorf("Error unsupported STM32 ID: 0x%X\n", deviceId)
			}
			else
				errorf("ERROR: No valid STmicro device ID found\n")
		else if( e != ERROR_NOTIFIED)
			 errorf("Error:\tCan't access target device!\n\tIf reset is disabled (\"dr\" option), try with reset.")
		return ERROR_NOTIFIED
	}
	return ERROR_OK
}

/////////////////////////////////////////////////////
//
//
//
function findDevice()
{
	if (VERSION < 6.0) {
		errorf("Error:\n\nIncompatible EBlink version %.2f\n\tPlease update\n", VERSION)
		throw ERROR_NOTIFIED
	}

	deviceId = 0
	local rom = readRomTableId()

	// If the probe can't read the ROM table, only the DBGMCU IDCODE is used
	if (rom != null) {
		// It must be a STmicro device
		if (rom.designer != JEP106_ST)
			throw ERROR_NOT_FOUND

		// Families identified by the ROM table part number
		foreach (family, ids in STMICRO_ROM) {
			if (ids.find(rom.part) != null) {
				deviceId = rom.part
				noticef("STmicro device : 0x%X\n", deviceId)
				require("stmicro/stm32" + family + ".script")
				stm32_device()
				return
			}
		}
	}

	// Check the architecture
	local cpu = targetApi.getCpuName()
	if (!(cpu in STMICRO)) {
		if (rom == null) noVendorCheckWarning()
		throw ERROR_NOT_FOUND
	}

	local arch = STMICRO[cpu]

	// Scan the device ID registers of this architecture
	foreach (addr in arch.regs) {
		try { deviceId = intrfApi.read(addr) & 0xfff; if (deviceId) break }
		catch (e) {}
	}

	if (deviceId) {
		noticef("STmicro device : 0x%X\n", deviceId)

		// Find the script file that supports this device ID
		foreach (family, ids in arch.fam) {
			if (ids.find(deviceId) != null) {
				// Include the corresponding script file and initialize the device
				require("stmicro/stm32" + family + ".script")
				stm32_device()
				return
			}
		}
	}

	if (rom == null) noVendorCheckWarning()
	throw ERROR_NOT_FOUND
}

/////////////////////////////////////////////////////
//
//  Nothing found and the probe can't read the ROM table
//
function noVendorCheckWarning()
{
	userf("\nWARNING: The probe firmware can't read the debug port registers (readDap).\n" +
	      "         The STmicro vendor check is skipped and devices without a DBGMCU\n" +
	      "         IDCODE (e.g. STM32WB0) can't be detected.\n" +
	      "         Please update the probe firmware (STlink/V2 J24 or higher).\n")
}

/////////////////////////////////////////////////////
//
//  Read the JEP106 designer code and part number from the
//  ROM table of the current AP (fields as Black Magic Probe adi.c)
//
//  Returns null if the probe can't read the MEM-AP BASE (readDap),
//  designer is -1 if there is no ROM table or no JEP106 code
//
function readRomTableId()
{
	local romBase
	try {
		romBase = intrfApi.readDap(intrfApi.getDapAp(), 0xF8) & 0xFFFFFFFF   // MEM-AP BASE
	}
	catch (e) {
		// Squirrel errors to the caller, an interface error means no readDap
		if (typeof e == "string")
			throw e
		return null
	}

	local noRom = { designer = -1, part = 0 }
	try {
		if (romBase == 0xFFFFFFFF || !(romBase & 1))   // Not present
			return noRom
		romBase = romBase & 0xFFFFF000

		// The ID registers have their data in the lowest byte
		local pidr0 = intrfApi.read(romBase + 0xFE0) & 0xFF
		local pidr1 = intrfApi.read(romBase + 0xFE4) & 0xFF
		local pidr2 = intrfApi.read(romBase + 0xFE8) & 0xFF
		local pidr4 = intrfApi.read(romBase + 0xFD0) & 0xFF

		// No JEP106 code (legacy ASCII)
		if (!(pidr2 & 0x08))
			return noRom

		local designer = ((pidr4 & 0x0F) << 8) | ((pidr2 & 0x07) << 4) | (pidr1 >> 4)
		local part     = ((pidr1 & 0x0F) << 8) | pidr0

		if (designer == JEP106_ERRATA_STM32WX)
			designer = JEP106_ST

		debugf("ROM table : designer 0x%03X part 0x%03X\n", designer, part)
		return { designer = designer, part = part }
	}
	catch (e) {
		// Squirrel errors to the caller, an interface error means no ROM table
		if (typeof e == "string")
			throw e
		return noRom
	}
}

/////////////////////////////////////////////////////////////////////////////////
//
// Additional commands after reset (optional) called by EBlink
//
// resetType:
//        SYSTEM_RESET
//        CORE_RESET
//        JTAG_RESET
//        USER_RESET
//
function  ebResetPost(resetType)
{
	try {
		// Check if there is an user defined post reset hook, the user
		// can add his own reset strategy with -S <myscript> as last
		// defined script on the cli.
		if (isScriptObject("ebResetPostHook"))
			return ebResetPostHook(resetType)

		// We don't use this if the reset is a user_script type. In that
		// case, the user is responsible for the initialization.
		//
		if( resetType != USER_RESET ){

			// Set the Stack pointer according the Vector table entry
			targetApi.writeReg("SP", intrfApi.read(resetVector))

			// Set the Program pointer according the Vector table entry
			targetApi.writeReg("PC", intrfApi.read(resetVector + 4))
		}
	}
	catch(e) {
		// Catch Squirrel errors in other optional scripts (e.g. ebResetPostHook)
		if(catchString(e))
			return ERROR_NOTIFIED

	   if(e < ERROR_NOTIFIED)
				errorf("ERROR(%d): reset failed\n", e )

	   return ERROR_NOTIFIED
	}

	return ERROR_OK
}
